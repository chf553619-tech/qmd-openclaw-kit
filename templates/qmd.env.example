# Copy to .env if you want fixed overrides

# Explicit backend override:
# auto | cuda | vulkan | false
QMD_LLAMA_GPU=

# Optional model overrides
QMD_EMBED_MODEL=
QMD_GENERATE_MODEL=
QMD_RERANK_MODEL=

# Optional context window tuning
QMD_EXPAND_CONTEXT_SIZE=2048

# Optional OpenClaw paths
WORKSPACE_ROOT=$HOME/.openclaw/workspace
OPENCLAW_HOME=$HOME/.openclaw
